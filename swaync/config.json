{
  "$schema": "/etc/xdg/swaync/configschema.json",
  "positionX": "right",
  "positionY": "top",
  "cssPriority": "user",
  "control-center-width": 420,
  "fit-to-screen": true,

  "notification-window-width": 400,
  "notification-icon-size": 40,
  "notification-body-image-height": 500,
  "notification-body-image-width": 500,
  "notification-inline-replies": true,
  "notification-2fa-action": false,

  "timeout": 3,
  "timeout-low": 2,
  "timeout-critical": 6,

  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": false,
  "script-fail-notify": true,

  "widgets": [
    "buttons-grid#cc-pills",
    "buttons-grid#cc-circles",
    "backlight#cc-slider",
    "title#cc-title",
    "notifications"
  ],

  "widget-config": {
    "buttons-grid#cc-header": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "⚙",
          "command": "echo 'Settings'"
        },
        {
          "label": "⋮",
          "command": "echo 'Menu'"
        }
      ]
    },

    "buttons-grid#cc-pills": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰂎  VoWiFi",
          "command": "echo 'VoWiFi'"
        },
        {
          "label": "󰤨  Wi-Fi               ❯",
          "command": "echo 'Wi-Fi'"
        }
      ]
    },

    "buttons-grid#cc-circles": {
      "buttons-per-row": 5,
      "actions": [
        {
          "label": "⇅",
          "command": "echo 'Mobile Data'"
        },
        {
          "label": "󰂯",
          "command": "echo 'Bluetooth'"
        },
        {
          "label": "󰈁",
          "command": "echo 'Auto Rotate'"
        },
        {
          "label": "󰌵",
          "command": "echo 'Flashlight'"
        },
        {
          "label": "󰝟",
          "command": "echo 'Silent'"
        }
      ]
    },

    "backlight#cc-slider": {
      "label": "󰃠",
      "device": "intel_backlight"
    },

    "title#cc-title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "clear"
    }
  }
}
