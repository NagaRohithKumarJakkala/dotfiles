{
    // General Settings
    "layer": "top",
    // "margin-top": 14,
    "margin-top": 4,
    "margin-bottom": 0,
    "margin-left": 14,
    "margin-right": 14,    
    "spacing": 0,

    // Load Modules
    "include": [
        "~/.config/ml4w/settings/waybar-quicklinks.json",
        "~/.config/waybar/modules.json"
    ],

    // Modules Left
    "modules-left": [
        "hyprland/workspaces",
        "wlr/taskbar",
        //"custom/media",
        "custom/hypridle",
        "custom/empty"
    ],

    // Modules Center
    "modules-center": [
        "clock",
        "custom/empty"
    ],

    // Modules Right    
    "modules-right": [
        "pulseaudio",
        "bluetooth",
        "network",
        "cpu",
        "memory",
        "battery", 
        "power-profiles-daemon",
        "tray",
        "custom/notification"
    ]
}
